# URL центрального хаба (через VPN / локальный IP или ngrok для тестов)
HUB_URL=http://192.168.100.1:8000

# API-ключ этой локации — скопируйте из веб-интерфейса хаба (Настройки → Локации)
API_KEY=ваш_api_ключ_здесь

# Сетевой интерфейс этого устройства
INTERFACE=eth0

# Локальная подсеть для сканирования
SUBNET=192.168.1.0/24

# Интервал сканирования устройств (секунды)
SCAN_INTERVAL=60

# Интервал heartbeat (секунды)
HEARTBEAT_INTERVAL=30

# Включить DNS-захват (требует CAP_NET_RAW / sudo)
DNS_CAPTURE=false

# Размер DNS-батча за одну отправку
DNS_BATCH_SIZE=100
