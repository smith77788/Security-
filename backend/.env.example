# Home Network Guardian — настройки окружения
# Скопируйте этот файл в backend/.env и заполните значения

# ── Основные настройки ──────────────────────────────────────────
DEMO_MODE=false
ADMIN_PASSWORD=changeme

# Секрет для JWT токенов (длинная случайная строка)
JWT_SECRET=change-me-use-long-random-secret-in-production
JWT_EXPIRE_HOURS=168

# ── Сеть ────────────────────────────────────────────────────────
# Имя сетевого интерфейса (eth0, wlan0, Wi-Fi, Ethernet и т.д.)
# Оставьте пустым — система определит автоматически
NETWORK_INTERFACE=

# Локальная подсеть (определяется автоматически если пусто)
LOCAL_SUBNET=192.168.1.0/24

# Интервал сканирования устройств в секундах
SCAN_INTERVAL_SECONDS=60

# ── DNS перехват ─────────────────────────────────────────────────
# Только если у вас настроен OpenWrt или DNS через систему
DNS_CAPTURE_ENABLED=false

# ── Telegram бот ────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── OpenWrt роутер (опционально) ─────────────────────────────────
OPENWRT_HOST=
OPENWRT_USER=root
OPENWRT_PORT=22
OPENWRT_SYSLOG_PORT=5514

# ── Хранение данных ──────────────────────────────────────────────
# Путь к базе данных SQLite (по умолчанию рядом с main.py)
# DB_PATH=C:\Users\YourName\Security\backend\family_security.db

# Дней хранить логи
LOG_RETENTION_DAYS=30

# ── CORS (для фронтенда) ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
