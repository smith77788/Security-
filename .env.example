# -------------------------------------------------------
# FAMILY SECURITY — example environment configuration
# Copy to .env and adjust before running:
#   cp .env.example .env
# -------------------------------------------------------

# --- General ---
# true = use demo/seed data, no real network scanning
DEMO_MODE=true

# Admin password (protects /api/settings endpoints when DEMO_MODE=false)
ADMIN_PASSWORD=changeme

# --- Network ---
# The interface your Linux box uses for the LAN (eth0, wlan0, enp3s0, etc.)
NETWORK_INTERFACE=eth0

# Your local subnet in CIDR notation
LOCAL_SUBNET=192.168.1.0/24

# How often (seconds) to rescan for devices
SCAN_INTERVAL_SECONDS=60

# Enable passive DNS packet capture (requires CAP_NET_RAW / sudo)
# Also requires: uncomment cap_add in docker-compose.yml, or run with --network host
DNS_CAPTURE_ENABLED=false

# --- Data retention ---
LOG_RETENTION_DAYS=30

# --- Authentication (JWT) ---
# Long random secret used to sign login tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-use-long-random-secret
# Token lifetime in hours (168 = 7 days)
JWT_EXPIRE_HOURS=168

# --- Telegram notifications (optional) ---
# 1. Create a bot via @BotFather and paste its token here
# 2. Get your chat id from @userinfobot
# 3. Send /start to your bot once so it can message you
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
